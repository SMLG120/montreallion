# Server-only Postgres connection (Supabase). Never expose to the client.
# On Vercel use the Supabase *transaction pooler* URL (port 6543):
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For `npm run db:migrate` use the direct or session-pooler URL (port 5432).
# Leave unset for local dev to use the in-memory store (refused on Vercel).
DATABASE_URL=

# Optional: connection pool size per server instance (default 5; use 1-2 on serverless).
DATABASE_POOL_MAX=

# Salt for hashing client IPs in rate-limit keys (raw IPs are never stored).
RATE_LIMIT_SALT=

# Integration tests only: a disposable LOCAL database whose name ends in _test.
TEST_DATABASE_URL=postgres://localhost:5432/montreallion_test

# Admin console (/admin). Disabled unless set to 24+ random characters, e.g. `openssl rand -base64 32`.
# Rotating it signs every admin out.
ADMIN_TOKEN=

# Accounts: Neon Auth (Console → your project → Auth). Server-only. Leave both empty to keep accounts off.
# NEON_AUTH_BASE_URL is the branch's Auth URL; the cookie secret signs session cookies (32+ chars:
# `openssl rand -base64 32`). Rotating the secret signs everyone out.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Local development / end-to-end tests only: an in-memory sign-in backend whose codes are readable at
# /api/auth/dev-code. Ignored on Vercel (and flagged by /api/health there). Never set it in production.
# AUTH_DEV_BACKEND=1
