{
  "name": "montreallion",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.ts migrate",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.ts seed",
    "db:reset": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.ts reset",
    "test:db": "vitest run --config vitest.db.config.mts",
    "etl:build": "cd etl && python3 -m montreallion_etl build",
    "etl:review": "cd etl && python3 -m montreallion_etl review",
    "etl:audit": "cd etl && python3 -m montreallion_etl audit",
    "etl:test": "cd etl && python3 -m unittest discover -s tests",
    "db:export-reviews": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.ts export-reviews",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke.ts",
    "smoke:map": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke-map.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run etl:test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neon/auth": "0.8.2",
    "@react-three/fiber": "9.8.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "6.17.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "three": "0.187.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
